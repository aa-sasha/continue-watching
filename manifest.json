{
  "manifest_version": 3,
  "name": "Anime Tracker — продолжить просмотр",
  "version": "2.2.0",
  "description": "Запоминает сезон, серию и момент остановки на YummyAnime и NewDeaf — как «Продолжить просмотр» на HDrezka.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["icons.js", "shared.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Продолжить просмотр",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
