{
  "manifest_version": 3,
  "name": "Продолжить просмотр — трекер серий",
  "short_name": "Трекер серий",
  "version": "1.1.0",
  "description": "Запоминает серию и момент, где вы остановились на сайтах с видео, и возвращает к ним в один клик. Данные — только у вас.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Продолжить просмотр",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
